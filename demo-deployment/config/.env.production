# ============================================================
# Defendra.AI - Production Environment Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials to git!
# ============================================================

APP_NAME=Defendra.AI
ENVIRONMENT=production
DEBUG=false

# ── Database (MySQL on Render/Railway) ─────────────────────────────────────
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://crps_user:YOUR_PASSWORD@defendra-mysql:3306/cyber_resilience_db
AUTO_CREATE_TABLES=true

# ── JWT Authentication ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Or use: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE-WITH-64-CHARACTER-RANDOM-STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS Origins ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend URLs
ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://your-domain.com

# ── Firebase (Optional - for Firestore database) ────────────────────────────
FIREBASE_PROJECT_ID=defendraai
# Leave empty for production (use credentials below)
FIRESTORE_EMULATOR_HOST=
# Path to Firebase service account JSON
FIREBASE_CREDENTIALS_PATH=
# Or base64-encoded credentials (for cloud deployment)
FIREBASE_CREDENTIALS_JSON=

# ── Device Heartbeat ────────────────────────────────────────────────────────
HEARTBEAT_TIMEOUT_SECONDS=120
LOG_EXPORT_LIMIT=10000

# ── Email Notifications (Optional) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_FROM_EMAIL=noreply@defendra.ai

# ── Hugging Face Sentinel AI (Optional) ─────────────────────────────────────
# Create token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_PROVIDER=featherless-ai
HUGGINGFACE_LLM_ENABLED=false
