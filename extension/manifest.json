{
  "manifest_version": 3,
  "name": "Defendra Browser Monitor (Demo)",
  "version": "0.1",
  "description": "Detects suspicious page overlays and unexpected inputs and reports events to a local Defendra backend (demo).",
  "permissions": ["scripting", "storage", "notifications", "activeTab", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": "icon48.png",
    "default_popup": "popup.html",
    "default_title": "Browser Monitor"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
