# ── Defendra Backend ──────────────────────────────────────────────────────────
BACKEND_EMAIL=admin@defendra.com
BACKEND_PASSWORD=Admin@1234
# Base URL of the Defendra backend (no trailing slash)
MARIA_API_URL=http://127.0.0.1:8000

# JWT from Defendra — admin role required for POST /api/devices registration;
# any authenticated user can POST /api/alerts. Use POST /api/auth/login.
MARIA_API_TOKEN=your_jwt_token_here

# ── Device Identity ───────────────────────────────────────────────────────────
DEVICE_NAME=MY-PC

# (Optional) The agent writes the assigned Firestore device id to logs/device_id.txt.

# ── Email Scanner (optional) ─────────────────────────────────────────────────
# Leave empty to disable email scanning (avoids Gmail auth errors in dev).
# For Gmail: enable 2FA, create an App Password, paste it here — NOT your normal password.
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# ── API Keys ──────────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
