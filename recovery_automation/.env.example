# Recovery & Automation Module — environment template
# Copy to .env and adjust values.

# ── Service ───────────────────────────────────────────────────────────────────
RECOVERY_HOST=0.0.0.0
RECOVERY_PORT=8001
RECOVERY_DEBUG=false

# ── Defendra backend integration (existing APIs) ─────────────────────────────
DEFENDRA_API_URL=http://127.0.0.1:8000
# JWT from POST /api/auth/login (optional if email/password set)
DEFENDRA_API_TOKEN=
DEFENDRA_API_EMAIL=admin@example.com
DEFENDRA_API_PASSWORD=ChangeMe123!

# ── Backup storage ────────────────────────────────────────────────────────────
BACKUP_ROOT=backups
BACKUP_DEFAULT_PATHS=./data,./config
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ── AWS S3 (optional, legacy) ──────────────────────────────────────────────────
# S3 is now optional — Firebase is the primary cloud storage for backups.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=defendra-backups/
S3_UPLOAD_ENABLED=false

# ── Rclone (placeholder) ──────────────────────────────────────────────────────
RCLONE_REMOTE=
RCLONE_ENABLED=false

# ── Email notifications ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=recovery@defendra.local
SMTP_TO=security@example.com
SMTP_USE_TLS=true

# ── Telegram (placeholder) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Firebase Cloud Storage (PRIMARY backup storage) ────────────────────────────
# Used by BOTH user backups (BackupService) AND admin recovery (AdminFirebaseService).
#
# User backups: When a device_id is provided, BackupService uploads to Firebase at:
#   backups/{device_id}/{backup_id}.zip
#
# Admin recovery: AdminFirebaseService downloads compromised backups from Firebase
#   using elevated Firebase Admin SDK privileges.
#
# Path to your Firebase Service Account JSON key file, OR paste the raw JSON.
# NEVER commit this file or its contents to source control.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Cloud Storage bucket name (e.g. defendra-backups.appspot.com)
FIREBASE_STORAGE_BUCKET=defendra-backups.appspot.com

# ── Admin Download Directory ──────────────────────────────────────────────────
# Local directory where admin-downloaded compromised backups are saved.
# These are stored SEPARATELY from user backups and are NOT visible in /backup/list.
# Leave blank to use default: recovery_automation/admin_downloads/
ADMIN_DOWNLOAD_DIR=

