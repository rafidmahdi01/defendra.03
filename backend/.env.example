APP_NAME=Defendra.AI
ENVIRONMENT=development
DEBUG=false

# ── Firebase (pick ONE) ───────────────────────────────────────────────────────
# A) Local development — start emulator from project root:
#    npm run firestore:emulator
#    then set:
FIRESTORE_EMULATOR_HOST=
FIREBASE_PROJECT_ID=defendraai

# B) Cloud Firestore — download a service account JSON from Firebase Console and set:
FIREBASE_CREDENTIALS_PATH=C:/Users/rafooood/Downloads/defendraai-firebase-adminsdk-fbsvc-8d4faea4a3.json
# (Leave FIRESTORE_EMULATOR_HOST empty when using a real key.)

DATABASE_URL=mysql+pymysql://crps_user:change-me@127.0.0.1:3306/cyber_resilience_db
AUTO_CREATE_TABLES=true
JWT_SECRET_KEY=replace-with-a-64-character-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HEARTBEAT_TIMEOUT_SECONDS=120
LOG_EXPORT_LIMIT=10000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=alerts@example.com

# Hugging Face — used by Sentinel chat (dashboard widget)
# Create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_PROVIDER=featherless-ai
# false = snapshot-only chat
HUGGINGFACE_LLM_ENABLED=true

