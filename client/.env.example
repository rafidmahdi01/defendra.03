# Defendra backend URL
SERVER_URL=http://127.0.0.1:8000

# Admin credentials for device registration + alerts (or set API_TOKEN instead)
API_EMAIL=admin@defendra.com
API_PASSWORD=Admin@1234
# API_TOKEN=

# Optional device label (defaults to hostname)
# DEVICE_NAME=my-laptop
# Optional fixed location shown in dashboard (otherwise auto-detected)
# DEVICE_LOCATION=Colombo, Sri Lanka

# Feature toggles
ENABLE_POPUP_ALERTS=false

# Intervals (seconds)
HEARTBEAT_INTERVAL=30
BEHAVIOR_INTERVAL=15
USB_POLL_INTERVAL=5
EMAIL_SCAN_INTERVAL=60
COMMAND_POLL_INTERVAL=20
BACKUP_INTERVAL=3600
NETWORK_CHECK_INTERVAL=10

CPU_ALERT_THRESHOLD=85
