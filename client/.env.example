# Defendra Client Agent Configuration Template
SERVER_URL=https://api.technohavenmalaysia.com
RECOVERY_AUTOMATION_URL=http://127.0.0.1:8001

# Machine authentication (required). Must match DEVICE_ENROLLMENT_KEY on the backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value; no human account or password is used by the agent.
DEVICE_ENROLLMENT_KEY=
API_TOKEN=

# Device Configuration (optional override)
DEVICE_NAME=
DEVICE_LOCATION=

# Feature Toggles
ENABLE_POPUP_ALERTS=false
USB_HID_AUTO_BLOCK=false
